# 复制为 .env 后按需修改。这些值不会写入代码仓库（见 .gitignore）。

# 服务监听地址与端口（本机自用，默认仅监听回环地址）
W2A_HOST=127.0.0.1
W2A_PORT=8000

# 可选：给本反代加一层访问口令；留空表示不校验（OpenAI 客户端的 api_key 随便填即可）
# 一旦设置，客户端需带 Authorization: Bearer <W2A_API_KEY>
W2A_API_KEY=

# 存储根目录（相对项目根或绝对路径），存放浏览器 profile、票据、会话库等敏感数据
W2A_STORAGE_DIR=storage

# CDP 真流式（Network.streamResourceContent）：1=逐块下发，0=退回整段读取
W2A_CDP_STREAM=1

# 流式空闲超时（秒）：超过该时间没有新数据则结束本次读取
W2A_STREAM_IDLE_TIMEOUT=60
